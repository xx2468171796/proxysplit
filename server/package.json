{
  "name": "proxysplit-commercial",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "dotenv -e .env -- pnpm --parallel --filter @proxysplit/api --filter @proxysplit/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "dotenv -e .env -- pnpm --filter @proxysplit/db migrate",
    "keys:generate": "node scripts/generate-license-keys.mjs"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
