NODE_ENV=development
HOST=127.0.0.1
PORT=18780
PUBLIC_BASE_URL=http://127.0.0.1:18780
DATABASE_URL=postgres://proxysplit:change-me@127.0.0.1:5432/proxysplit
REDIS_URL=redis://127.0.0.1:6379
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_TTL_DAYS=30
LICENSE_PRIVATE_KEY_PEM=
LICENSE_PUBLIC_KEY_PEM=
ADMIN_ORIGIN=http://127.0.0.1:18781
VITE_API_URL=http://127.0.0.1:18780
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-immediately

# 支付通道凭据。命名规则：<credential_ref>_APP_ID / <credential_ref>_APP_SECRET，
# 其中 credential_ref 来自 payment_providers.credential_ref（迁移 0002 播种为 PAYMENT_ZHONGZHUAN）。
# 未配置时下单/回调/查单都会返回 503 PAYMENT_UNAVAILABLE。
PAYMENT_ZHONGZHUAN_APP_ID=
PAYMENT_ZHONGZHUAN_APP_SECRET=

# 统一支付中心 zhifu-service（迁移 0022 起为当前通道 zhifu-center）。值在堡垒机资产，只放运行时 env。
# 不全 = 会员下单报 503「统一支付中心尚未配置」。回调地址（在中心「站点」登记）：<PUBLIC_BASE_URL>/v1/pay/center/notify
PAY_MODE=center
PAY_CENTER_URL=https://zfzx.zygskins.cn
PAY_CENTER_APP_ID=
PAY_CENTER_SECRET=
# 付款前人机验证绑定的站点域名（凭证按域名绑定；中心要求每笔先验证时必填，生产 = proxysplit.zygskins.cn）
PAY_HV_HOST=

# 同事节点上报（docs/节点上报.md）：节点链接 / 订阅地址加密密钥，32 字节 base64（openssl rand -base64 32）。
# 不配则不存链接（其他字段照收）。生产放在 /opt/proxysplit/secrets/runtime.env。
NODE_LINK_KEY=
# 能在后台解密查看链接的超级管理员用户名，逗号分隔，默认 admin
SUPER_ADMIN_USERNAMES=admin

# 短信验证码有两种模式（没有第三种）：
# ① 中心模式（生产）：LCV_SITE_ID / LCV_HOST / LCV_SITE_SECRET 三项都配 = 走公司雷池验证中心 leichiwaf-verify
#    （发码、核码、冷却、限额、通道凭据都在中心；要 REDIS_URL，键前缀 proxysplit:lcvotp:）。只配一部分启动报错。
#    LCV_SITE_ID     中心 sites.json 里登记的站点 id（生产 proxysplit）
#    LCV_HOST        出滑块的页面域名，人机凭证按它绑定（生产 proxysplit.zygskins.cn）
#    LCV_SITE_SECRET 中心发给本站的密钥（≥ 32 字符，值在堡垒机资产，只放运行时 env）；也用作本站暂存的哈希密钥
#    LCV_URL         中心签名端口；api 容器连不到宿主 127.0.0.1，生产填宿主桥接地址（如 http://172.20.0.1:18977）。不配 = http://127.0.0.1:8977
# ② 本地模式（开发 / 测试 / 回退）：上面三项都留空，走下面的云片直发 + sms_codes 表。
LCV_SITE_ID=
LCV_HOST=
LCV_SITE_SECRET=
LCV_URL=
# 本地模式的云片（堡垒机资产 #289；IP 白名单 = 深圳机）。不配 key：开发环境验证码打到日志，生产 503 SMS_UNAVAILABLE。
YUNPIAN_API_KEY=
YUNPIAN_TPL_ID=6437354
# 配置云同步 / 云端配置加密密钥，32 字节 base64（openssl rand -base64 32），存堡垒机资产；不配则同步接口 503。
CONFIG_SYNC_KEY=

# 代理站：aigw 公开接口 GET <AIGW_PUBLIC_BASE>/api/public/dealers/<slug>（代理商品牌 / 客服微信 / 是否启用）。
# 公网 ai.zygskins.cn 有 WAF 可能拦非浏览器请求：同机部署时用内网地址 + Host 头，例如
#   AIGW_PUBLIC_BASE=http://host.docker.internal:8310  AIGW_PUBLIC_HOST=ai.zygskins.cn
AIGW_PUBLIC_BASE=https://ai.zygskins.cn
AIGW_PUBLIC_HOST=
