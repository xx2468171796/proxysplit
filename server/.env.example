NODE_ENV=development
HOST=127.0.0.1
PORT=18780
PUBLIC_BASE_URL=http://127.0.0.1:18780
DATABASE_URL=postgres://proxysplit:change-me@127.0.0.1:5432/proxysplit
REDIS_URL=redis://127.0.0.1:6379
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_TTL_DAYS=30
LICENSE_PRIVATE_KEY_PEM=
LICENSE_PUBLIC_KEY_PEM=
ADMIN_ORIGIN=http://127.0.0.1:18781
VITE_API_URL=http://127.0.0.1:18780
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-immediately

# 支付通道凭据。命名规则：<credential_ref>_APP_ID / <credential_ref>_APP_SECRET，
# 其中 credential_ref 来自 payment_providers.credential_ref（迁移 0002 播种为 PAYMENT_ZHONGZHUAN）。
# 未配置时下单/回调/查单都会返回 503 PAYMENT_UNAVAILABLE。
PAYMENT_ZHONGZHUAN_APP_ID=
PAYMENT_ZHONGZHUAN_APP_SECRET=

# 同事节点上报（docs/节点上报.md）：节点链接 / 订阅地址加密密钥，32 字节 base64（openssl rand -base64 32）。
# 不配则不存链接（其他字段照收）。生产放在 /opt/proxysplit/secrets/runtime.env。
NODE_LINK_KEY=
# 能在后台解密查看链接的超级管理员用户名，逗号分隔，默认 admin
SUPER_ADMIN_USERNAMES=admin
