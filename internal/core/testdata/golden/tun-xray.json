{
  "dns": {
    "final": "dns-direct",
    "rules": [
      {
        "process_path": [
          "C:\\x\\xray.exe"
        ],
        "server": "dns-direct"
      },
      {
        "rule_set": [
          "geosite-cn"
        ],
        "server": "dns-direct"
      }
