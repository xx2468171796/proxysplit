          "172.19.0.1/32",
          "fdfe:dcba:9876::1/128"
        ],
        "method": "drop"
      },
      {
        "action": "reject",
        "mode": "and",
        "rules": [
          {
            "ip_version": 6
          },
          {
            "invert": true,
            "ip_is_private": true
          },
          {
            "invert": true,
            "port": [
              53
            ]
          }
        ],
        "type": "logical"
      },
      {
        "network": [
          "icmp"
        ],
        "outbound": "direct"
      },
      {
        "action": "sniff"
      },
      {
        "outbound": "direct",
        "process_path": [
          "C:\\x\\xray.exe"
        ]
      },
      {
        "action": "hijack-dns",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "type": "logical"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "action": "reject",
        "ip_version": 6
      },
      {
        "action": "reject",
        "rule_set": [
          "geosite-ads"
        ]
      },
      {
        "outbound": "direct",
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ]
