      },
      {
        "server": "223.5.5.5",
        "tag": "dns-direct",
        "type": "udp"
      }
    ],
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
