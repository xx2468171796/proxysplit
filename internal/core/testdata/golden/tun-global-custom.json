{
  "dns": {
    "final": "dns-direct",
    "rules": [
      {
        "rule_set": [
          "geosite-cn"
        ],
        "server": "dns-direct"
      }
    ],
    "servers": [
      {
        "detour": "proxy",
        "server": "8.8.8.8",
        "tag": "dns-remote",
        "type": "udp"
      },
      {
        "server": "223.5.5.5",
        "tag": "dns-direct",
        "type": "udp"
      }
    ],
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "mtu": 1500,
      "stack": "system",
      "strict_route": true,
      "tag": "tun-in",
      "type": "tun"
    }
  ],
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "outbounds": [
    {
      "alter_id": 0,
      "security": "auto",
      "server": "example.com",
      "server_port": 443,
      "tag": "proxy",
      "tls": {
        "enabled": true,
        "insecure": false,
        "server_name": "cdn.example.com"
      },
      "transport": {
        "headers": {
          "Host": "cdn.example.com"
        },
        "path": "/path",
        "type": "ws"
      },
      "type": "vmess",
      "uuid": "11111111-2222-3333-4444-555555555555"
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-direct"
    },
    "final": "proxy",
    "rule_set": [
      {
        "format": "binary",
        "path": "GEO/geosite-cn.srs",
        "tag": "geosite-cn",
        "type": "local"
      },
      {
        "format": "binary",
        "path": "GEO/geoip-cn.srs",
        "tag": "geoip-cn",
        "type": "local"
      },
      {
        "format": "binary",
        "path": "GEO/geosite-category-ads-all.srs",
        "tag": "geosite-ads",
        "type": "local"
      }
    ],
    "rules": [
      {
        "action": "reject",
        "ip_cidr": [
          "172.19.0.1/32",
          "fdfe:dcba:9876::1/128"
        ],
        "method": "drop"
      },
      {
        "action": "reject",
        "mode": "and",
        "rules": [
          {
            "ip_version": 6
          },
          {
            "invert": true,
            "ip_is_private": true
          },
          {
            "invert": true,
            "port": [
              53
            ]
          }
        ],
        "type": "logical"
      },
      {
        "network": [
          "icmp"
        ],
        "outbound": "direct"
      },
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "type": "logical"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "outbound": "direct",
        "process_name": [
          "proxysplit.exe"
        ]
      },
      {
        "action": "reject",
        "ip_version": 6
      },
      {
        "domain": [
          "a.com"
        ],
        "outbound": "proxy"
      },
      {
        "ip_cidr": [
          "10.0.0.0/8"
        ],
        "outbound": "direct"
      },
      {
        "action": "reject",
        "domain_keyword": [
          "ad"
        ]
      }
    ]
  }
}
