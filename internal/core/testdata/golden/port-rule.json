{
  "dns": {
    "final": "dns-remote",
    "rules": [
      {
        "clash_mode": "direct",
        "server": "dns-direct"
      },
      {
        "rule_set": [
          "geosite-cn"
        ],
        "server": "dns-direct"
      }
    ],
    "servers": [
      {
        "server": "223.5.5.5",
        "tag": "dns-direct",
        "type": "udp"
      },
      {
        "detour": "proxy",
        "server": "8.8.8.8",
        "tag": "dns-remote",
        "type": "udp"
      }
    ]
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:1",
      "secret": "s"
    }
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "listen_port": 10801,
      "tag": "in-port",
      "type": "socks",
      "users": [
        {
          "password": "p",
          "username": "u"
        }
      ]
    }
  ],
  "log": {
    "level": "info",
    "timestamp": true
  },
  "outbounds": [
    {
      "flow": "xtls-rprx-vision",
      "server": "example.com",
      "server_port": 443,
      "tag": "proxy",
      "tls": {
        "enabled": true,
        "insecure": false,
        "reality": {
          "enabled": true,
          "public_key": "jNXHt1yRo0vDuchQlIP6Z0ZvjT3KtzVI-T4E7RoLJS0",
          "short_id": "0123abcd"
        },
        "server_name": "www.microsoft.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "type": "vless",
      "uuid": "11111111-2222-3333-4444-555555555555"
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-direct"
    },
    "final": "proxy",
    "rule_set": [
      {
        "format": "binary",
        "path": "GEO/geosite-cn.srs",
        "tag": "geosite-cn",
        "type": "local"
      },
      {
        "format": "binary",
        "path": "GEO/geoip-cn.srs",
        "tag": "geoip-cn",
        "type": "local"
      },
      {
        "format": "binary",
        "path": "GEO/geosite-category-ads-all.srs",
        "tag": "geosite-ads",
        "type": "local"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "domain": [
          "api.example.cn"
        ],
        "domain_suffix": [
          "api.example.cn"
        ],
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "clash_mode": "direct",
        "outbound": "direct"
      },
      {
        "clash_mode": "global",
        "outbound": "proxy"
      },
      {
        "action": "reject",
        "rule_set": [
          "geosite-ads"
        ]
      },
      {
        "outbound": "direct",
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ]
