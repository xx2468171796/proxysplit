{
  "name": "proxysplit-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "vite --port 5288 --strictPort --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5289 --strictPort --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src",
    "check:size": "node scripts/check-size.mjs",
    "check:recipe": "node scripts/check-recipe.mjs",
    "review": "vite build -c vite.review.config.ts --mode review --outDir node_modules/.review-build --emptyOutDir && node scripts/review-pages.mjs node_modules/.review-build",
    "check:bundle": "vite build && xingneng bundle --dist dist --config xingneng.bundle.json",
    "check": "pnpm typecheck && pnpm lint && pnpm check:size && pnpm check:recipe && pnpm check:bundle"
  },
  "dependencies": {
    "@ankotti/admin-ui": "git+http://s3.alonelife.top:32109/admin/yanzheng.git#adminUI-v9.6.1&path:/packages/adminUI",
    "@gsap/react": "^2.1.2",
    "dongxiao": "git+http://s3.alonelife.top:32109/admin/yanzheng.git#dongxiao-v1.8.0&path:/packages/dongxiao",
    "gsap": "^3.15.0",
    "ogl": "^1.0.11",
    "qiantai": "git+http://s3.alonelife.top:32109/admin/yanzheng.git#qiantai-v0.8.0&path:/packages/qiantai",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xingneng": "git+http://s3.alonelife.top:32109/admin/yanzheng.git#xingneng-v1.4.1&path:/packages/xingneng",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
